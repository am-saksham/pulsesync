# Backend Environment Variables (Store in backend/.env)
DATABASE_URL="postgresql://neondb_owner:npg_...your_url.../neondb?sslmode=require"
REDIS_URL="rediss://default:...your_url...io:6379"
JWT_SECRET="super_secret_jwt_key_123"
FRONTEND_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/google/callback"
GEMINI_API_KEY="AIzaSy...your_gemini_key..."

# Frontend Environment Variables (Store in frontend/.env.local)
NEXT_PUBLIC_API_URL="http://localhost:3001"
